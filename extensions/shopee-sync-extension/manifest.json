{
  "manifest_version": 3,
  "name": "OPENVN Shopee Auto-Sync — thaimy1605 (#197195817)",
  "version": "2.1.0",
  "description": "Tiện ích liên kết riêng cho shop thaimy1605 (#197195817) — đồng bộ kép Cookie Shopee về Máy bán hàng & Cloud 24/7 (Supabase + Render Singapore).",
  "permissions": [
    "cookies",
    "alarms",
    "storage",
    "tabs"
